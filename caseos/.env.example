# CaseOS needs no API key: the agents run on the Claude subscription of the local Claude Code session
# (Claude Agent SDK). Only set ANTHROPIC_API_KEY if you deliberately want API billing instead.
# ANTHROPIC_API_KEY=

# Where cases live (default: ./cases)
# CASEOS_CASES_DIR=./cases
# Server (loopback only by default)
# CASEOS_HOST=127.0.0.1
# CASEOS_PORT=8780
# Model and cost controls (effort per role, budget per run) are in caseos/config.py
# CASEOS_MODEL=claude-opus-5
# CASEOS_AUTO_COS=1        # COS evaluates impact automatically when research completes
